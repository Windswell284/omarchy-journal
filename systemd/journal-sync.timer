[Unit]
Description=Sync the journal every few minutes
Documentation=https://github.com/Windswell284/omarchy-journal

[Timer]
# The pull half needs polling: an edit made on the phone touches nothing here,
# so only the clock can notice it. A wall-clock schedule rather than
# OnUnitActiveSec=, which has no anchor after a logout and leaves the timer
# elapsed with nothing scheduled until the note next changes.
OnCalendar=*:0/5
Persistent=true
RandomizedDelaySec=15

[Install]
WantedBy=timers.target
