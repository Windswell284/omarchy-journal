#!/usr/bin/env python3
"""Drive the whole two-way loop against a fake Calendar API.

Every step is followed by a second sync that must do nothing. That is the
assertion that matters: a sync which cannot leave the two sides agreeing will
push its own last change back and forth forever, and a one-shot test of each
direction will not catch it.

Uses a temporary vault and config, so it touches neither your notes nor your
calendar. Needs no credentials and no network.
"""
import importlib.util, importlib.machinery, itertools, json, os, shutil, sys, tempfile, datetime

PLUG = os.path.dirname(os.path.abspath(__file__))
sys.path.insert(0, PLUG)
loader = importlib.machinery.SourceFileLoader("jsync", f"{PLUG}/journal-sync")
spec = importlib.util.spec_from_loader("jsync", loader)
JS = importlib.util.module_from_spec(spec); loader.exec_module(JS)

TMP = tempfile.mkdtemp()
VAULT = os.path.join(TMP, "vault"); os.makedirs(VAULT)
for name in ("CONFIG", "GLOSSARY", "STATE", "TOKEN", "CONFLICTS"):
    setattr(JS, name, os.path.join(TMP, os.path.basename(getattr(JS, name))))
JS.vault_dir = lambda: VAULT

NOTE = """# September 2026

- **1 T**
- **2 W** 1 pm Panza, 2:15 pm David
- **3 T**
- **4 F** 4 pm PIA
- **17 S** To Beijing

## Focus

- shoulder
"""
open(f"{VAULT}/2026-09.md", "w").write(NOTE)
JS._write_json(JS.GLOSSARY, {"terms": {"Panza": "Dr. Panza", "PIA": "PIA Physical Therapy"},
                             "phrases": {"To Beijing": "Flight to Beijing"}})

class Req:
    def __init__(self, fn): self.fn = fn
    def execute(self): return self.fn()

class FakeEvents:
    def __init__(self, store): self.store = store; self.ids = itertools.count(1)
        
    def list(self, calendarId, timeMin, timeMax, **kw):
        lo, hi = timeMin[:10], timeMax[:10]
        def go():
            items = [e for e in self.store.values()
                     if lo <= (e["start"].get("date") or e["start"]["dateTime"][:10]) < hi]
            return {"items": items}
        return Req(go)
    def insert(self, calendarId, body):
        def go():
            eid = f"ev{next(self.ids)}"
            e = dict(body, id=eid, updated=stamp())
            self.store[eid] = e
            return e
        return Req(go)
    def update(self, calendarId, eventId, body):
        def go():
            e = dict(body, id=eventId, updated=stamp())
            self.store[eventId] = e
            return e
        return Req(go)
    def delete(self, calendarId, eventId):
        def go(): self.store.pop(eventId, None); return {}
        return Req(go)

class FakeCals:
    def get(self, calendarId): return Req(lambda: {"id": calendarId})
    def insert(self, body): return Req(lambda: {"id": "cal1", **body})

class FakeSvc:
    def __init__(self): self.store = {}; self._ev = FakeEvents(self.store)
    def events(self): return self._ev
    def calendars(self): return FakeCals()

CLOCK = [datetime.datetime(2026, 9, 4, 12, 0, tzinfo=datetime.timezone.utc)]
def stamp():
    CLOCK[0] += datetime.timedelta(minutes=1)
    return CLOCK[0].isoformat().replace("+00:00", "Z")

SVC = FakeSvc()
JS.service = lambda interactive=False: SVC

class Args:
    dry_run = False; online = False; month = "2026-09"; prefer = None

def run(label):
    print(f"\n### {label}")
    JS.cmd_sync(Args())

def show_note():
    days, _ = __import__("journal_notes").parse_note(open(f"{VAULT}/2026-09.md").read())
    print("    note:", {k: v for k, v in days.items() if v})
def show_cal():
    print("    cal: ", sorted((e["summary"], e["start"].get("date") or e["start"]["dateTime"][:16])
                              for e in SVC.store.values()))

run("1. first sync"); show_cal()
run("2. sync again (must be a no-op)")
print("\n### 3. retitle on the phone: 'Dr. Panza' -> 'Dr. Panza, annual physical'")
[e for e in SVC.store.values() if e["summary"] == "Dr. Panza"][0].update(
    summary="Dr. Panza, annual physical", updated=stamp())
run("   sync"); show_note()
run("4. sync again (must be a no-op -- catches push-back loops)")
print("\n### 5. edit the note: PIA moves 4 pm -> 5 pm")
t = open(f"{VAULT}/2026-09.md").read().replace("4 pm PIA", "5 pm PIA")
open(f"{VAULT}/2026-09.md", "w").write(t)
run("   sync"); show_cal()
run("6. sync again (no-op)")
print("\n### 7. new event created on the phone")
SVC.events().insert("cal1", {"summary": "Rolling Hills Country Club",
                             "start": {"dateTime": "2026-09-04T17:30:00-07:00"},
                             "end": {"dateTime": "2026-09-04T18:30:00-07:00"}}).execute()
run("   sync"); show_note()
run("8. sync again (no-op)")
print("\n### 9. delete a line from the note (David on the 2nd)")
t = open(f"{VAULT}/2026-09.md").read().replace(", 2:15 pm David", "")
open(f"{VAULT}/2026-09.md", "w").write(t)
run("   sync"); show_cal()
run("10. sync again (no-op)")
def carrier():
    return [e for e in SVC.store.values()
            if JS.SECTIONS_KEY in e.get("extendedProperties", {}).get("private", {})][0]
def show_page():
    print("    note page:", __import__("journal_notes").parse_sections(
        open(f"{VAULT}/2026-09.md").read()))
    print("    cal page: ", repr(carrier()["description"]))

print("\n### 11. the facing page rode out with the first sync")
show_page()
print("\n### 12. add a Grateful line on the phone, in the event description")
c = carrier()
c.update(description=c["description"].replace(
    "## Grateful for\n", "## Grateful for\n\n- the rain\n"), updated=stamp())
run("   sync"); show_page()
run("13. sync again (must be a no-op)")
print("\n### 14. edit the note: another Focus line")
t = open(f"{VAULT}/2026-09.md").read().replace("- shoulder", "- shoulder\n- sleep")
open(f"{VAULT}/2026-09.md", "w").write(t)
os.utime(f"{VAULT}/2026-09.md", (2e9, 2e9))     # newer than any fake event
run("   sync"); show_page()
run("15. sync again (no-op)")
print("\n### 16. delete the carrier on the phone -- the boxes must survive")
SVC.store.pop(carrier()["id"])
run("   sync"); show_page()
run("17. sync again (no-op)")
print("\n### 18. the day log never sees the carrier")
show_note()

print("\n### final note ###")
print(open(f"{VAULT}/2026-09.md").read())
shutil.rmtree(TMP)
